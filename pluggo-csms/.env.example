# Kopieer naar .env en vul in met echte waarden
# .env staat in .gitignore — nooit committen

# Supabase project URL — te vinden in Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key — Supabase Dashboard → Settings → API → service_role (secret)
# LET OP: geeft volledige DB-toegang (bypass RLS). Alleen server-side gebruiken.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Poort voor de HTTP-API (RemoteStart/Stop endpoints). Default 9001.
# Als deze poort al bezet is, kies iets anders.
CSMS_HTTP_PORT=9001

# Shared secret voor de HTTP-API. De Supabase Edge Function moet deze
# meesturen in de X-CSMS-API-Key header. Zonder deze env var draait de
# HTTP-API in dev-modus (iedereen mag) — NIET DOEN IN PRODUCTIE.
# Genereer bijv. met: openssl rand -hex 32
CSMS_API_KEY=
