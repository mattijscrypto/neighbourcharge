<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Pluggo</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Pluggo</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>nl.pluggoapp.pluggo</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>pluggo</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>comgooglemaps</string>
			<string>maps</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>NSCameraUsageDescription</key>
		<string>Pluggo gebruikt je camera om een foto te maken van je laadpaal en oprit, zodat boekers weten waar ze moeten zijn.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Pluggo gebruikt je locatie om je op de kaart te plaatsen, zodat je laadpalen in je buurt kunt zien.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Pluggo gebruikt je locatie om je op de kaart te plaatsen, zodat je laadpalen in je buurt kunt zien.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Pluggo heeft toegang nodig tot je foto's om een foto van je laadpaal en oprit te kunnen uploaden.</string>
		<!-- UIApplicationSceneManifest tijdelijk verwijderd: flutter_stripe 11.x'
		     PaymentSheet vindt de presenting view controller niet in
		     scene-based apps (sheet rendert technisch, maar onzichtbaar).
		     Zonder scene manifest valt iOS terug op AppDelegate.window —
		     Stripe SDK kan daar wél tegen. Als we naar flutter_stripe 12.x+
		     upgraden, kunnen we de scene manifest terugzetten. -->
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- iPad-specifieke orientations weggehaald: app is iPhone-only (TARGETED_DEVICE_FAMILY = 1) -->
	</dict>
</plist>
